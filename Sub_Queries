19) WITH clause buses above average capacity

SQL> WITH avg_capacity AS
  2  (
  3    SELECT AVG(capacity) AS avg_cap
  4    FROM Bus
  5  )
  6  SELECT bus_id, capacity
  7  FROM Bus, avg_capacity
  8  WHERE capacity > avg_cap;

    BUS_ID   CAPACITY
---------- ----------
         1         50

20) CASE with subquery classify buses

SQL> SELECT bus_id,
  2         capacity,
  3         CASE
  4           WHEN capacity >
  5                (SELECT AVG(capacity) FROM Bus)
  6           THEN 'High Capacity'
  7           ELSE 'Low Capacity'
  8         END AS capacity_status
  9  FROM Bus;

    BUS_ID   CAPACITY CAPACITY_STAT
---------- ---------- -------------
         1         50 High Capacity
         2         45 Low Capacity


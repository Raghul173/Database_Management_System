1. Palindrome:

DECLARE
  str      VARCHAR2(100) := 'madam';  -- Input string
  reversed VARCHAR2(100) := '';
  i        INTEGER;
BEGIN
  
  FOR i IN REVERSE 1..LENGTH(str) LOOP
    reversed := reversed || SUBSTR(str, i, 1);
  END LOOP;

  IF str = reversed THEN
    DBMS_OUTPUT.PUT_LINE(str || ' is a palindrome');
  ELSE
    DBMS_OUTPUT.PUT_LINE(str || ' is not a palindrome');
  END IF;
END;   


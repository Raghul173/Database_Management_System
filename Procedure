A) Write a PL/SQL procedure to return the department name with the maximum number of employees.

PL/SQL Procedure Code


CREATE OR REPLACE PROCEDURE Get_Max_Emp_Dept (
    p_dept_name OUT VARCHAR2
) AS
BEGIN
    -- Query to find the department with the most employees
    SELECT d.department_name
    INTO p_dept_name
    FROM departments d
    JOIN employees e ON d.department_id = e.department_id
    GROUP BY d.department_name
    ORDER BY COUNT(e.employee_id) DESC
    FETCH FIRST 1 ROW ONLY;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        p_dept_name := 'No departments found';
    WHEN OTHERS THEN
        p_dept_name := 'Error: ' || SQLERRM;
END;
/

How to Execute the Procedure

SET SERVEROUTPUT ON;
DECLARE
    v_name VARCHAR2(100);
BEGIN
    Get_Max_Emp_Dept(v_name);
    DBMS_OUTPUT.PUT_LINE('Department with maximum employees: ' || v_name);
END;
/


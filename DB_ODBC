package db;
import java.sql.*;

public class DBConnection {
    private static Connection conn = null;

    public static Connection connect(String url, String user, String pass) throws SQLException {
        conn = DriverManager.getConnection(url, user, pass);
        return conn;
    }

    public static Connection getConnection() {
        return conn;
    }

    public static void close() {
        try {
            if (conn != null && !conn.isClosed()) conn.close();
        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}


BookingService.java:
package controller;

import db.DBConnection;
import java.sql.*;
import javax.swing.table.DefaultTableModel;

public class BookingService {

    private Connection conn() {
        return DBConnection.getConnection();
    }


    //  PASSENGER CRUD


    public void insertPassenger(String name, int age, String gender, String contact) throws SQLException {
        String sql = "INSERT INTO Passenger (name, age, gender, contact) VALUES (?, ?, ?, ?)";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setString(1, name);
            ps.setInt(2, age);
            ps.setString(3, gender);
            ps.setString(4, contact);
            ps.executeUpdate();
        }
    }

    public void updatePassenger(int id, String name, int age, String gender, String contact) throws SQLException {
        String sql = "UPDATE Passenger SET name=?, age=?, gender=?, contact=? WHERE passenger_id=?";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setString(1, name);
            ps.setInt(2, age);
            ps.setString(3, gender);
            ps.setString(4, contact);
            ps.setInt(5, id);
            ps.executeUpdate();
        }
    }

    public void deletePassenger(int id) throws SQLException {
        String sql = "DELETE FROM Passenger WHERE passenger_id=?";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setInt(1, id);
            ps.executeUpdate();
        }
    }

    public DefaultTableModel getAllPassengers() throws SQLException {
        String sql = "SELECT * FROM Passenger";
        return buildTable(sql);
    }

    // Subquery: passengers older than average age
    public DefaultTableModel getAboveAvgAgePassengers() throws SQLException {
        String sql = "SELECT * FROM Passenger WHERE age > (SELECT AVG(age) FROM Passenger)";
        return buildTable(sql);
    }

    // Search passengers by name
    public DefaultTableModel searchPassengers(String keyword) throws SQLException {
        String sql = "SELECT * FROM Passenger WHERE name LIKE ?";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setString(1, "%" + keyword + "%");
            ResultSet rs = ps.executeQuery();
            return resultSetToModel(rs);
        }
    }


    //  BOOKING CRUD


    public void insertBooking(int passengerId, int scheduleId, int seatNo, String status) throws SQLException {
        String sql = "INSERT INTO Booking (passenger_id, schedule_id, seat_no, status) VALUES (?, ?, ?, ?)";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setInt(1, passengerId);
            ps.setInt(2, scheduleId);
            ps.setInt(3, seatNo);
            ps.setString(4, status);
            ps.executeUpdate();
        }
    }

    public void updateBooking(int bookingId, String status) throws SQLException {
        String sql = "UPDATE Booking SET status=? WHERE booking_id=?";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setString(1, status);
            ps.setInt(2, bookingId);
            ps.executeUpdate();
        }
    }

    public void deleteBooking(int bookingId) throws SQLException {
        String sql = "DELETE FROM Booking WHERE booking_id=?";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setInt(1, bookingId);
            ps.executeUpdate();
        }
    }

    // JOIN: Booking + Passenger + Schedule + Route + Location
    public DefaultTableModel getAllBookingsWithDetails() throws SQLException {
        String sql =
            "SELECT b.booking_id, p.name AS passenger, " +
            "       l1.loc_name AS source, l2.loc_name AS destination, " +
            "       s.travel_date, b.seat_no, b.status " +
            "FROM Booking b " +
            "JOIN Passenger p ON b.passenger_id = p.passenger_id " +
            "JOIN Schedule s  ON b.schedule_id  = s.schedule_id " +
            "JOIN Route r     ON s.route_id     = r.route_id " +
            "JOIN Location l1 ON r.source       = l1.loc_id " +
            "JOIN Location l2 ON r.destination  = l2.loc_id";
        return buildTable(sql);
    }

    // Subquery: bookings whose seat_no is above the average seat_no
    public DefaultTableModel getBookingsAboveAvgSeat() throws SQLException {
        String sql =
            "SELECT * FROM Booking WHERE seat_no > (SELECT AVG(seat_no) FROM Booking)";
        return buildTable(sql);
    }


    //  SCHEDULE (view with JOIN)


    public DefaultTableModel getAllSchedules() throws SQLException {
        String sql =
            "SELECT s.schedule_id, b.reg_no AS bus, " +
            "       l1.loc_name AS source, l2.loc_name AS destination, " +
            "       s.dept_time, s.arrival_time, s.travel_date " +
            "FROM Schedule s " +
            "JOIN Bus b      ON s.bus_id      = b.bus_id " +
            "JOIN Route r    ON s.route_id    = r.route_id " +
            "JOIN Location l1 ON r.source     = l1.loc_id " +
            "JOIN Location l2 ON r.destination= l2.loc_id";
        return buildTable(sql);
    }


    //  PAYMENT


    public DefaultTableModel getAllPayments() throws SQLException {
        String sql =
            "SELECT py.transaction_id, p.name AS passenger, " +
            "       py.method, py.payment_time, py.status " +
            "FROM Payment py " +
            "JOIN Booking b  ON py.booking_id   = b.booking_id " +
            "JOIN Passenger p ON b.passenger_id = p.passenger_id";
        return buildTable(sql);
    }

    public void insertPayment(int bookingId, String method, String status) throws SQLException {
        String sql = "INSERT INTO Payment (booking_id, method, status) VALUES (?, ?, ?)";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setInt(1, bookingId);
            ps.setString(2, method);
            ps.setString(3, status);
            ps.executeUpdate();
        }
    }

    public void updatePayment(int transactionId, String status) throws SQLException {
        String sql = "UPDATE Payment SET status=? WHERE transaction_id=?";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setString(1, status);
            ps.setInt(2, transactionId);
            ps.executeUpdate();
        }
    }

    public void deletePayment(int transactionId) throws SQLException {
        String sql = "DELETE FROM Payment WHERE transaction_id=?";
        try (PreparedStatement ps = conn().prepareStatement(sql)) {
            ps.setInt(1, transactionId);
            ps.executeUpdate();
        }
    }

    // Subquery: payments for confirmed bookings only
    public DefaultTableModel getPaymentsForConfirmedBookings() throws SQLException {
        String sql =
            "SELECT * FROM Payment WHERE booking_id IN " +
            "(SELECT booking_id FROM Booking WHERE status = 'Confirmed')";
        return buildTable(sql);
    }

        //  BUS + STAFF (JOIN view)


    public DefaultTableModel getAllBusWithStaff() throws SQLException {
        String sql =
            "SELECT b.bus_id, b.reg_no, b.type, b.capacity, " +
            "       st.name AS driver, st.license_no " +
            "FROM Bus b " +
            "JOIN Staff st ON b.staff_id = st.staff_id";
        return buildTable(sql);
    }

    private DefaultTableModel buildTable(String sql) throws SQLException {
        try (Statement st = conn().createStatement();
             ResultSet rs = st.executeQuery(sql)) {
            return resultSetToModel(rs);
        }
    }

    private DefaultTableModel resultSetToModel(ResultSet rs) throws SQLException {
        ResultSetMetaData meta = rs.getMetaData();
        int cols = meta.getColumnCount();
        String[] colNames = new String[cols];
        for (int i = 1; i <= cols; i++) colNames[i - 1] = meta.getColumnName(i).toUpperCase();

        DefaultTableModel model = new DefaultTableModel(colNames, 0) {
            @Override public boolean isCellEditable(int r, int c) { return false; }
        };
        while (rs.next()) {
            Object[] row = new Object[cols];
            for (int i = 1; i <= cols; i++) row[i - 1] = rs.getObject(i);
            model.addRow(row);
        }
        return model;
    }
}


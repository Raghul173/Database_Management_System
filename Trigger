A) A)	Write a code in PL/SQL to create a trigger that validates the availability of items before allowing an order to be placed, considering stock levels and pending orders.

The following trigger assumes two tables: Products (holding stock levels) and Orders (storing order details)

-- Supporting Table Structure
CREATE TABLE Products (
    product_id NUMBER PRIMARY KEY,
    product_name VARCHAR2(100),
    stock_quantity NUMBER
);

CREATE TABLE Orders (
    order_id NUMBER PRIMARY KEY,
    product_id NUMBER REFERENCES Products(product_id),
    order_quantity NUMBER,
    status VARCHAR2(20) -- e.g., 'Pending', 'Completed'
);

Command for Trigger:

CREATE OR REPLACE TRIGGER Validate_Order_Availability
BEFORE INSERT ON Orders
FOR EACH ROW
DECLARE
    v_current_stock NUMBER;
    v_pending_orders NUMBER;
BEGIN
    -- 1. Get current physical stock
    SELECT stock_quantity INTO v_current_stock 
    FROM Products WHERE product_id = :NEW.product_id;

    -- 2. Sum up existing order quantities for this product
    SELECT NVL(SUM(order_quantity), 0) INTO v_pending_orders 
    FROM Orders WHERE product_id = :NEW.product_id;

    -- 3. Validation logic
    IF (v_current_stock - v_pending_orders - :NEW.order_quantity) < 0 THEN
        RAISE_APPLICATION_ERROR(-20001, 'Insufficient stock. Available: ' 
            || (v_current_stock - v_pending_orders));
    END IF;
END;
/


B) B)	Design a trigger that sends an email notification to a predefined address whenever an error occurs during a specific operation.

CREATE OR REPLACE TRIGGER Email_On_Error
AFTER SERVERERROR ON SCHEMA
DECLARE
    v_error_msg VARCHAR2(4000);
    v_user      VARCHAR2(30);
BEGIN
    -- 1. Capture the error message and the user who caused it
    v_error_msg := DBMS_UTILITY.FORMAT_ERROR_STACK;
    v_user      := SYS_CONTEXT('USERENV', 'SESSION_USER');

    -- 2. Send the email notification
    UTL_MAIL.SEND(
        sender     => 'database_system@yourdomain.com',
        recipients => 'admin_alerts@yourdomain.com', -- The predefined address
        subject    => 'Critical Database Error in Schema: ' || v_user,
        message    => 'An error occurred at ' || TO_CHAR(SYSDATE, 'DD-MON-YYYY HH24:MI:SS') || 
                      CHR(10) || 'User: ' || v_user || 
                      CHR(10) || 'Error Detail: ' || v_error_msg
    );
EXCEPTION
    WHEN OTHERS THEN
        -- Prevent the trigger from crashing the entire database if mail fails
        NULL; 
END;
/
